# Cavos (Stellar embedded wallet)
# App → Overview = App ID (public). Do NOT paste Team API keys (cav_…).
# Settings → Callback URLs + Allowed web origins must include BOTH:
#   http://localhost:3000
#   http://localhost:3000/
# Environments → development: enable social recovery + fund gas if you use environment=development.
NEXT_PUBLIC_CAVOS_APP_ID=
NEXT_PUBLIC_CAVOS_NETWORK=testnet
NEXT_PUBLIC_CAVOS_ENVIRONMENT=development
NEXT_PUBLIC_CAVOS_REDIRECT_URI=http://localhost:3000/

# Legacy MiniPay / Celo (kept for page.minipay-legacy.tsx; not used on home)
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=
NEXT_PUBLIC_APP_NETWORK=celo
NEXT_PUBLIC_CELO_RPC_URL=https://forno.celo.org
NEXT_PUBLIC_CELO_SEPOLIA_RPC_URL=https://forno.celo-sepolia.celo-testnet.org
NEXT_PUBLIC_SQUID_INTEGRATOR_ID=
COIN_GECKO_API_KEY=
CELO_RPC_URL=https://forno.celo.org
# Legacy Celo APIs only; ramp persistence uses the RAMP_DB Cloudflare D1 binding.
DATABASE_URL=

# Private ramp integration API. SERVER ONLY; never put these in NEXT_PUBLIC_* or browser code.
# Apply migrations/d1 via Wrangler --env staging before enabling the endpoints.
# Random secret (at least 32 characters) for trusted server-to-server requests.
RAMP_INTERNAL_API_TOKEN=
# Base64 encoded 32 random bytes. Keep stable; rotation requires snapshot re-encryption.
RAMP_ENCRYPTION_KEY=
RAMP_PROVIDER=pods
# Explicit local simulation; never returns executable funding instructions.
RAMP_ALLOW_MOCK=false
PODS_API_KEY=
PODS_API_BASE_URL=https://api.pods.finance
# Enable only after confirming Stellar mainnet and its funding response with Pods.
PODS_STELLAR_ENABLED=false
# Exact Stellar USDC tokenIn identifier supplied by Pods; no guessed default.
PODS_STELLAR_TOKEN_IN=
PODS_WEBHOOK_SECRET=

# Pods Hosted KYC. Requires account enablement + allowlisted HTTPS return URLs from Pods.
PODS_KYC_ENABLED=false
PODS_KYC_REDIRECT_URL=
# Informational environment marker; never enables the sandbox by itself.
PODS_ENVIRONMENT=unconfirmed
# The official sandbox is pBRL on Base Sepolia, separate from Stellar.
# Full runner requires explicit enablement + confirmed URL; --probe never creates a profile/quote.
PODS_SANDBOX_ENABLED=false
PODS_SANDBOX_API_BASE_URL=

# TuCOP: own provider account, pay only. Independent of Pods user KYC.
# Disabled until the selected environment, business and Stellar corridor are verified.
TUCOPRAMP_API_KEY=
TUCOPRAMP_ENVIRONMENT=sandbox
TUCOPRAMP_ENABLED=false
# Optional override; defaults to the official host for the selected environment.
TUCOPRAMP_API_BASE_URL=
# Standard Webhooks whsec_ secret, distinct from the API key and Pods secret.
TUCOPRAMP_WEBHOOK_SECRET=
